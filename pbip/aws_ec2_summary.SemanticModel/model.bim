          {
            "name": "pricing_plan_label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    fct_ec2_pricing[term_type] = \"OnDemand\", \"On-Demand Base\",",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"all upfront\", \"1Y All UF\",",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"partial upfront\", \"1Y Partial UF\",",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"no upfront\", \"1Y No UF\",",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"all upfront\", \"3Y All UF\",",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"partial upfront\", \"3Y Partial UF\",",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"no upfront\", \"3Y No UF\",",
              "    \"Other\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "c313e83c-95bd-4530-94b4-3cbb55be2399",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "priciing plan sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    -- 1. Baseline",
              "    fct_ec2_pricing[purchase_option] = \"On-Demand\", 1,",
              "    ",
              "    -- 2. 3-Year Options",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"All Upfront\", 2,",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"Partial Upfront\", 3,",
              "    fct_ec2_pricing[lease_year] = 3 && fct_ec2_pricing[purchase_option] = \"No Upfront\", 4,",
              "    ",
              "    -- 3. 1-Year Options",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"All Upfront\", 5,",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"Partial Upfront\", 6,",
              "    fct_ec2_pricing[lease_year] = 1 && fct_ec2_pricing[purchase_option] = \"No Upfront\", 7,",
              "    ",
              "    99",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "d52573dc-745d-4a65-85d8-b469ed35eff1",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "lease_year_label",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    fct_ec2_pricing[lease_year] = 0, \"On-Demand\",",
              "    fct_ec2_pricing[lease_year] = 1, \"1-Year\",",
              "    fct_ec2_pricing[lease_year] = 3, \"3-Year\",",
              "    \"Other\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "466fa1df-b670-4341-b27b-35fa5b25dd0c",
            "sortByColumn": "lease_year",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "total_upfront_fee",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "dataType": "double",
            "lineageTag": "0ce79dd2-657d-4b30-b882-9febde99123a",
            "sourceColumn": "total_upfront_fee",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "4843abb2-a54a-486a-b66b-3abc002fd5e1",
