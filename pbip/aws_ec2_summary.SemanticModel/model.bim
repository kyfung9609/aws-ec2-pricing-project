      {
        "name": "dim_waterfall_category",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Order",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "2f7774be-e250-45c4-9294-f5f755c13894",
            "sourceColumn": "Order",
            "summarizeBy": "sum"
          },
          {
            "name": "Category",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "58aab779-8d71-43f9-afad-2c768f1a486f",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "305613ef-951b-4bc0-9233-241b96d4c205",
        "measures": [
          {
            "name": "1 Linux Base",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [HourlyRate_Avg],",
              "    fct_ec2_pricing[operating_system] = \"Linux\",",
              "    fct_ec2_pricing[pre_installed_sw] = \"na\",",
              "    fct_ec2_pricing[license_model] = \"no license required\",",
              "    fct_ec2_pricing[term_type] = \"OnDemand\"",
              ")"
            ],
            "lineageTag": "865c18b7-77b5-4551-bbed-6d66b237255e"
          },
          {
            "name": "2 Win OS Premium",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _WinOnDemand = ",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        fct_ec2_pricing[operating_system] = \"Windows\",",
              "        fct_ec2_pricing[pre_installed_sw] = \"na\",",
              "        fct_ec2_pricing[license_model] = \"no license required\",",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "",
              "VAR _SelectedOS = SELECTEDVALUE(fct_ec2_pricing[operating_system], \"Windows\")",
              "    ",
              "VAR _WinPremium = ",
              "    IF(",
              "        _SelectedOS = \"Windows\", ",
              "        IF(ISBLANK(_WinOnDemand), 0, _WinOnDemand - [1 Linux Base]), ",
              "        0",
              "    )",
              "",
              "RETURN",
              "    _WinPremium"
            ],
            "lineageTag": "592ce01c-9797-4e6e-a828-13546e262d9a"
          },
          {
            "name": "3 Software Premium",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _SelectedOS = SELECTEDVALUE(fct_ec2_pricing[operating_system], \"Windows\")",
              "VAR _SelectedSW = SELECTEDVALUE(fct_ec2_pricing[pre_installed_sw], \"SQL Std\")",
              "",
              "VAR _SqlOnDemand = ",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        fct_ec2_pricing[operating_system]= _SelectedOS,",
              "        fct_ec2_pricing[pre_installed_sw] = _SelectedSW,",
              "        fct_ec2_pricing[license_model] = \"no license required\",",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "        ",
              "RETURN",
              "    IF(ISBLANK(_SqlOnDemand), 0, ",
              "        _SqlOnDemand - [1 Linux Base] - [2 Win OS Premium])"
            ],
            "lineageTag": "236f75bb-bf07-40ad-9471-e976d06383af"
          },
          {
            "name": "Waterfall Value",
            "expression": [
              "",
              "VAR _SelectedCategory = SELECTEDVALUE('dim_waterfall_category'[Category])",
              "",
              "RETURN",
              "    SWITCH(",
              "        _SelectedCategory,",
              "        \"01 Linux Base\", [1 Linux Base],",
              "        \"02 Win OS Premium\", [2 Win OS Premium],",
              "        \"03 Software Premium\", [3 Software Premium],",
              "        \"04 License Model\", [4 License Model],",
              "        BLANK()",
              "    )"
            ],
            "formatString": "+\\$#,0.0000;-\\$#,0.0000;\\$#,0.0000",
            "lineageTag": "44335dff-ca87-4964-b3df-c734e0b5d644"
          },
          {
            "name": "4 License Model",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _SelectedOS = SELECTEDVALUE(fct_ec2_pricing[operating_system], \"Windows\")",
              "VAR _SelectedSW = SELECTEDVALUE(fct_ec2_pricing[pre_installed_sw], \"SQL Std\")",
              "VAR _SelectedLM = SELECTEDVALUE(fct_ec2_pricing[license_model], \"no license required\")",
              "",
              "VAR _LicenseModel = ",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        fct_ec2_pricing[operating_system]= _SelectedOS,",
              "        fct_ec2_pricing[pre_installed_sw] = _SelectedSW,",
              "        fct_ec2_pricing[license_model] = _SelectedLM,",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "        ",
              "RETURN",
              "    IF(ISBLANK(_LicenseModel), 0, ",
              "        _LicenseModel - [1 Linux Base] - [2 Win OS Premium] - [3 Software Premium])"
            ],
            "lineageTag": "83210d10-8e8c-4c68-a6dc-8cade6b071e4"
          }
        ],
        "partitions": [
          {
            "name": "dim_waterfall_category",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlTSUTIwVPDJzCutUHBKLE5VitWJVjICiRophGfmKfgHKwQUpeZmluaCZYxBMsYKwflpJeWJRakociYgOROgWcmpecWpCr75Kak5SrGxAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Order = _t, Category = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Order\", Int64.Type}, {\"Category\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
