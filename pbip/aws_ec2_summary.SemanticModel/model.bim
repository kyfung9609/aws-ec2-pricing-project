      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "lineageTag": "45149c70-50cb-4f9c-98d3-8f3bab24f9b7",
        "measures": [
          {
            "name": "HourlyRate_Avg",
            "expression": "AVERAGE(fct_ec2_pricing[price_per_hour])* [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b2b908ed-68e0-4acb-abf5-7ef4e3a9c6ae"
          },
          {
            "name": "Total Offers",
            "expression": "COUNTROWS(fct_ec2_pricing)",
            "formatString": "#,0",
            "lineageTag": "ac509b98-72c9-4b93-902b-dcf5d408cd56"
          },
          {
            "name": "Avg Hourly Cost per vCPU",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    [HourlyRate_Avg],",
              "    AVERAGE(dim_instances[vcpu]),",
              "    0",
              ")* [Current Exchange Rate]"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "4f937b92-878f-4e5b-bbbb-f9e50971c381"
          },
          {
            "name": "Avg Hourly Cost per memory_GB",
            "expression": [
              "",
              "DIVIDE(",
              "    AVERAGE(fct_ec2_pricing[price_per_hour]),",
              "    AVERAGE(dim_instances[memory_gb])",
              ") * [Current Exchange Rate]"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "5665ab58-0f67-495d-9f68-a76b1b6a197d"
          },
          {
            "name": "HourlyRate_Min",
            "expression": "MIN(fct_ec2_pricing[price_per_hour])* [Current Exchange Rate]",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "e0a8d8f9-8555-4332-94bb-42ce1cd10c5b"
          },
          {
            "name": "HourlyRate_Max",
            "expression": "MAX(fct_ec2_pricing[price_per_hour])* [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "ddac9abe-9bfd-410a-8d98-fe8fb1986c63"
          },
          {
            "name": "HourlyRate_Median",
            "expression": "MEDIAN(fct_ec2_pricing[price_per_hour])* [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "325c18e4-624e-4ddc-bb01-eb6f427a10ce"
          },
          {
            "name": "HourlyRate_P25",
            "expression": "PERCENTILE.INC(fct_ec2_pricing[price_per_hour], 0.25)* [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "0845290a-4d8e-47db-b4c3-e14bacaac468"
          },
          {
            "name": "HourlyRate_P75",
            "expression": "PERCENTILE.INC(fct_ec2_pricing[price_per_hour], 0.75) * [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "6bc740bc-319a-45ef-9dd0-cfed8cf3d188"
          },
          {
            "name": "HourlyRate_25-50",
            "expression": "([HourlyRate_Median] - [HourlyRate_P25]) * [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "322f0c58-2cf3-4e05-88ce-4cfb19a73833"
          },
          {
            "name": "HourlyRate_50-75",
            "expression": "([HourlyRate_P75] - [HourlyRate_Median])* [Current Exchange Rate]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "319a9f7e-f3a2-4229-8539-10a7abadc4d6"
          },
          {
            "name": "P2_boxplot_Title_Dynamic",
            "expression": [
              "",
              "VAR _FormattedRate = FORMAT([HourlyRate_Max], \"$#,##0.00\")",
              "RETURN",
              "    \"Hourly Rate Distribution (Capped at \" & _FormattedRate & \"/hr)\""
            ],
            "lineageTag": "24548148-224f-459b-aba1-814f507fa7f3"
          },
          {
            "name": "P2_boxplot_ymax",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "[HourlyRate_Max] * 1.1",
            "lineageTag": "788910b8-9cfd-4dc6-b147-90728e4f9317"
          },
          {
            "name": "P2_scatter_title",
            "expression": [
              "",
              "VAR _FormattedRate = FORMAT([HourlyRate_Max], \"$#,##0.00\")",
              "RETURN",
              "    \"vCPU vs. Memory Distribution by Instance Category (Capped at \" & _FormattedRate & \"/hr)\""
            ],
            "lineageTag": "3df5623e-58b5-4713-90cb-e16837d2feab"
          },
          {
            "name": "Curr_Selection",
            "expression": "SELECTEDVALUE('Currency_Selection'[Currency], \"USD\")",
            "lineageTag": "31ea80b8-0ded-47db-82e9-e96f60a9f607"
          },
          {
            "name": "Curr_SelectedCurrSymbol",
            "expression": [
              "",
              "SELECTEDVALUE('Currency_Selection'[Symbol], \"$\")"
            ],
            "lineageTag": "2444306a-2b39-46cd-a830-d8ab897df30c"
          },
          {
            "name": "Current Exchange Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR SelectedSlicerRate = ",
              "    CALCULATE(",
              "        SELECTEDVALUE('USDCAD'[USDCAD], 1.39),",
              "        ALLSELECTED('USDCAD')",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        [Curr_Selection] = \"CAD\",",
              "        SelectedSlicerRate,",
              "        1.00",
              "    )"
            ],
            "lineageTag": "88ade7c2-cc72-4cd0-ab80-cad96720173e"
          },
          {
            "name": "Selected Memory Setting",
            "expression": [
              "",
              "VAR SelectedMem = SELECTEDVALUE(dim_instances[memory_gb])",
              "RETURN",
              "    IF(",
              "        ISFILTERED(dim_instances[memory_gb]),",
              "        IF(",
              "            ISBLANK(SelectedMem),",
              "            \"Memory: Multiple Selected\",",
              "            SelectedMem & \" GB\"",
              "        ),",
              "        \"All Sizes\"",
              "    )"
            ],
            "lineageTag": "659672bc-d753-49d4-88d5-9740c3d67082"
          },
          {
            "name": "Selected vCPU Setting",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR Selected = SELECTEDVALUE(dim_instances[vcpu])",
              "RETURN",
              "    IF(",
              "        ISFILTERED(dim_instances[vcpu]),",
              "        IF(",
              "            ISBLANK(Selected),",
              "            \"vCPU: Multiple Selected\",",
              "            Selected",
              "        ),",
              "        \"All Sizes\"",
              "    )"
            ],
            "lineageTag": "1c633665-ec7e-4650-bc1f-ea886208f5ec"
          },
          {
            "name": "P4 Base OnDemand Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "var base = ",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        REMOVEFILTERS(fct_ec2_pricing[term_type]),",
              "        REMOVEFILTERS(fct_ec2_pricing[purchase_option]),",
              "        REMOVEFILTERS(fct_ec2_pricing[lease_year]),",
              "        REMOVEFILTERS(fct_ec2_pricing[lease_year_label]),",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "",
              "RETURN",
              "    base",
              ""
            ],
            "lineageTag": "f66edf84-1f20-4f97-a779-784baa8fe447"
          },
          {
            "name": "P4 Dis% vs OnDemand",
            "expression": [
              "",
              "VAR _CurrentRate = [HourlyRate_Avg]",
              "VAR _BaseRate = [P4 Base OnDemand Rate]",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_CurrentRate) || ISBLANK(_BaseRate) || _BaseRate = 0,",
              "        BLANK(),",
              "        DIVIDE(_CurrentRate - _BaseRate, _BaseRate)",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "75c03b6d-def8-4825-9a59-b0618f4211f3"
          },
          {
            "name": "P4 Price Matrix",
            "expression": [
              "",
              "VAR _CurrentRate = [HourlyRate_Avg]",
              "VAR _BaseRate = [P4 Base OnDemand Rate]",
              "",
              "VAR _IsOnDemand = SELECTEDVALUE(fct_ec2_pricing[term_type]) = \"OnDemand\"",
              "",
              "VAR _DiscountPct = ",
              "    IF(",
              "        ISBLANK(_CurrentRate) || ISBLANK(_BaseRate) || _BaseRate = 0 || _IsOnDemand,",
              "        BLANK(),",
              "        DIVIDE(_CurrentRate - _BaseRate, _BaseRate)",
              "    )",
              "",
              "VAR _RateText = FORMAT(_CurrentRate, \"$#,##0.00\")",
              "VAR _DiscountText = IF(NOT ISBLANK(_DiscountPct), FORMAT(_DiscountPct, \"0.0%\"), \"\")",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_CurrentRate),",
              "        BLANK(),",
              "        IF(",
              "            _IsOnDemand || ISBLANK(_DiscountPct),",
              "            _RateText,",
              "            _RateText & \" (\" & _DiscountText & \")\"",
              "        )",
              "    )"
            ],
            "lineageTag": "f2372497-efb0-4d07-b2ad-31bca608d0bd"
          },
          {
            "name": "P4 Annual Saving",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "([P4 Base OnDemand Rate] - [HourlyRate_Avg]) * (24*365)",
            "lineageTag": "9b10bb1d-0794-46ed-8541-ed8387ff22ae"
          },
          {
            "name": "P4 Annual Savings Display",
            "expression": [
              "",
              "VAR _SavingsPerInstance = [P4 Annual Saving]",
              "VAR _FleetSize = Fleet_Size[Fleet_Size Value] ",
              "VAR _TotalFleetSavings = _SavingsPerInstance * _FleetSize",
              "",
              "VAR _FormattedSavings = FORMAT(_TotalFleetSavings, \"$#,##0\")",
              "",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        -- Case 1: On-Demand selected or no savings",
              "        _TotalFleetSavings = 0, \"$0 (Baseline)\",",
              "        ",
              "        -- Case 2: Standard Display with fleet context",
              "        _FleetSize = 1, _FormattedSavings & \" / yr\",",
              "        _FormattedSavings & \" / yr \" & UNICHAR(10) & \"(\" & _FleetSize & \" instances)\"",
              "    )"
            ],
            "lineageTag": "4ad16324-5558-4e33-8202-f4fbbbefe8cf"
          },
          {
            "name": "P4 OS Comparison Diff",
            "expression": [
              "",
              "VAR _CurrentOS = SELECTEDVALUE(fct_ec2_pricing[operating_system], \"Linux\")",
              "VAR _TargetOS = IF(_CurrentOS = \"Linux\", \"Windows\", \"Linux\")",
              "VAR _CurrentRate = [HourlyRate_Avg]",
              "",
              "VAR _OppositeOSRate = ",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        REMOVEFILTERS(fct_ec2_pricing[operating_system]),",
              "        fct_ec2_pricing[operating_system] = _TargetOS",
              "    )",
              "",
              "VAR _FleetSize = Fleet_Size[Fleet_Size Value]",
              "VAR _HourlyDiff = _CurrentRate - _OppositeOSRate",
              "VAR _AnnualDiff = _HourlyDiff * (24 * 365) * _FleetSize",
              "VAR _AbsFormatted = FORMAT(ABS(_AnnualDiff), \"$#,##0\")",
              "",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(_CurrentRate) || ISBLANK(_OppositeOSRate) || _AnnualDiff = 0, \"$0 / yr\",",
              "        ",
              "        -- Current OS is cheaper than target OS (Savings)",
              "        _AnnualDiff < 0, \"Saving \" & _AbsFormatted & \" / yr\" & UNICHAR(10) & \"(\" & _FleetSize & \" instances)\",",
              "        ",
              "        -- Current OS is more expensive than target OS (Premium)",
              "        _AnnualDiff > 0, \"Increasing \" & _AbsFormatted & \" / yr\" & UNICHAR(10) & \"(\" & _FleetSize & \" instances)\"",
              "    )"
            ],
            "lineageTag": "9b895ad7-59a2-4fc7-87a1-4a642b682dfb"
          },
          {
            "name": "P4 OS Card Title",
            "expression": [
              "",
              "VAR _CurrentOS = SELECTEDVALUE(fct_ec2_pricing[operating_system], \"windows\")",
              "VAR _TargetOS = IF(LOWER(_CurrentOS) = \"linux\", \"Windows\", \"Linux\")",
              "",
              "RETURN",
              "    \"Impact vs. \" & _TargetOS"
            ],
            "lineageTag": "663a11a5-e195-4a11-8e93-246447882a6d"
          },
          {
            "name": "P5 M_Cumulative Spend",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _CurrentMonth = SELECTEDVALUE(dim_month_axis[Value])",
              "VAR _FleetSize = Fleet_Size[Fleet_Size Value]",
              "VAR _MonthlyHours = 730 ",
              "",
              "VAR _LumpSumUpfrontPerInst = AVERAGE(fct_ec2_pricing[total_upfront_fee])* [Current Exchange Rate]",
              "VAR _RecurringRate = AVERAGE(fct_ec2_pricing[hourly_recurring_fee]) * [Current Exchange Rate]",
              "VAR _LeaseYear = SELECTEDVALUE(fct_ec2_pricing[lease_year], 0)",
              "",
              "-- Capital Jump Count",
              "VAR _RenewalCycles = ",
              "    SWITCH(",
              "        TRUE(),",
              "        _LeaseYear = 3 && _CurrentMonth >= 1, 1,",
              "        ",
              "        _LeaseYear = 1 && _CurrentMonth >= 25, 3,",
              "        _LeaseYear = 1 && _CurrentMonth >= 13, 2,",
              "        _LeaseYear = 1 && _CurrentMonth >= 1,  1,",
              "        ",
              "        -- On-Demand or No upfront",
              "        0",
              "    )",
              "",
              "-- 3. CapEx and OpEx",
              "VAR _TotalCapEx = _LumpSumUpfrontPerInst * _FleetSize * _RenewalCycles ",
              "VAR _TotalOpEx = _RecurringRate * _MonthlyHours * _CurrentMonth * _FleetSize",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_CurrentMonth),",
              "        BLANK(),",
              "        _TotalCapEx + _TotalOpEx",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "f58e9ebd-850e-4c99-bc37-34d14abee70a"
          },
          {
            "name": "P5 chart Title",
            "expression": [
              "",
              "    \"3-Year Cumulative Cash Outflow (\" & Fleet_Size[Fleet_Size Value] & \" instances)\""
            ],
            "lineageTag": "e5ccaa17-1ab9-44b7-ba51-5beae4486ae2"
          },
          {
            "name": "P5 M_Day1_CapEx",
            "expression": [
              "",
              "VAR _FleetSize = Fleet_Size[Fleet_Size Value]",
              "VAR _UpfrontUnit = AVERAGE(fct_ec2_pricing[total_upfront_fee])",
              "RETURN",
              "    _FleetSize * _UpfrontUnit * [Current Exchange Rate]"
            ],
            "formatString": "#,0",
            "lineageTag": "02095df1-f847-44ba-a88d-27ff0c4b9bfe"
          },
          {
            "name": "P5 M_Recurring_Hourly_Rate",
            "expression": [
              "",
              "VAR _FleetSize = Fleet_Size[Fleet_Size Value]",
              "VAR _HourlyRateUnit = AVERAGE(fct_ec2_pricing[hourly_recurring_fee])",
              "RETURN",
              "    _FleetSize * _HourlyRateUnit * [Current Exchange Rate]"
            ],
            "formatString": "0.00",
            "lineageTag": "a0b65ef5-6fd4-4755-a132-14781861e79a"
          },
          {
            "name": "P5 M_Month13",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [P5 M_Cumulative Spend],",
              "    dim_month_axis[Value] = 13",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "231614fd-d511-4ff8-bcc5-9af5f6edce6b"
          },
          {
            "name": "P5 M_3Yr_Total",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [P5 M_Cumulative Spend],",
              "    dim_month_axis[Value] = 36",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "ab9fc8f7-0f0f-4baf-b57d-231e9b1303cf"
          },
          {
            "name": "P5 M_3Yr_Net_Savings",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _OnDemandSpend = ",
              "    CALCULATE(",
              "        [P5 M_3Yr_Total],",
              "        fct_ec2_pricing[pricing_plan_label] = \"On-Demand Base\",",
              "        REMOVEFILTERS(fct_ec2_pricing[pricing_plan_label])",
              "    )",
              "VAR _CurrentPlanSpend = [P5 M_3Yr_Total]",
              "RETURN",
              "    IF(ISBLANK(_CurrentPlanSpend), BLANK(), _OnDemandSpend - _CurrentPlanSpend)"
            ],
            "formatString": "#,0",
            "lineageTag": "29170222-d87d-4bdb-b55c-76ab7e8d0ade"
          },
          {
            "name": "P5 M_Discount_Percent",
            "expression": [
              "",
              "VAR _OnDemandSpend = ",
              "    CALCULATE(",
              "        [P5 M_3Yr_Total],",
              "        fct_ec2_pricing[pricing_plan_label] = \"On-Demand Base\",",
              "        REMOVEFILTERS(fct_ec2_pricing[pricing_plan_label])",
              "    )",
              "VAR _NetSavings = [P5 M_3Yr_Net_Savings]",
              "RETURN",
              "    IF(_OnDemandSpend = 0, BLANK(), DIVIDE(_NetSavings, _OnDemandSpend, 0))"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "943f4917-e068-4307-8322-d7e5b76c6e94"
          },
          {
            "name": "P5 M_BreakEven_Display",
            "expression": [
              "",
              "VAR _Plan = SELECTEDVALUE(fct_ec2_pricing[pricing_plan_label])",
              "VAR _UpfrontUnit = SELECTEDVALUE(fct_ec2_pricing[total_upfront_fee], AVERAGE(fct_ec2_pricing[total_upfront_fee]))",
              "VAR _LeaseYear = SELECTEDVALUE(fct_ec2_pricing[lease_year], AVERAGE(fct_ec2_pricing[lease_year]))",
              "",
              "-------------------------------------------------------------------------",
              "-- 1. PRE-CHECK CRITERIA (On-Demand Baseline & No Upfront Immediate BE)",
              "-------------------------------------------------------------------------",
              "VAR _IsOnDemand = _Plan = \"On-Demand Base\" || _Plan = \"On-Demand\"",
              "VAR _IsNoUpfront = _UpfrontUnit = 0 && NOT(_IsOnDemand)",
              "",
              "-------------------------------------------------------------------------",
              "-- 2. DYNAMIC ITERATION LOOP ACROSS ALL 3 YEARS (Years 1, 2, and 3)",
              "-------------------------------------------------------------------------",
              "VAR _YearsTable = GENERATESERIES(1, 3, 1)",
              "",
              "VAR _BE_PointsTable = ",
              "    ADDCOLUMNS(",
              "        _YearsTable,",
              "        \"BE_Month\",",
              "            VAR _Y = [Value]",
              "            VAR _StartMo = (_Y - 1) * 12 + 1",
              "            VAR _EndMo = _Y * 12",
              "            ",
              "            -- Evaluate if cumulative spend starts ABOVE On-Demand at the beginning of the annual cycle",
              "            VAR _IsAboveOnDemandAtStart = ",
              "                CALCULATE([P5 M_Cumulative Spend], dim_month_axis[Value] = _StartMo) >= ",
              "                CALCULATE(",
              "                    [P5 M_Cumulative Spend], ",
              "                    dim_month_axis[Value] = _StartMo, ",
              "                    fct_ec2_pricing[pricing_plan_label] = \"On-Demand Base\", ",
              "                    REMOVEFILTERS(fct_ec2_pricing[pricing_plan_label])",
              "                )",
              "            ",
              "            RETURN",
              "                IF(",
              "                    _IsAboveOnDemandAtStart,",
              "                    -- Locate the exact month where cumulative spend drops below On-Demand within this year",
              "                    MINX(",
              "                        FILTER(",
              "                            ALL(dim_month_axis[Value]),",
              "                            dim_month_axis[Value] >= _StartMo && ",
              "                            dim_month_axis[Value] <= _EndMo &&",
              "                            [P5 M_Cumulative Spend] < ",
              "                                CALCULATE(",
              "                                    [P5 M_Cumulative Spend],",
              "                                    fct_ec2_pricing[pricing_plan_label] = \"On-Demand Base\",",
              "                                    REMOVEFILTERS(fct_ec2_pricing[pricing_plan_label])",
              "                                )",
              "                        ),",
              "                        dim_month_axis[Value]",
              "                    ),",
              "                    BLANK()",
              "                )",
              "    )",
              "",
              "-- Concatenate all valid breakeven months dynamically (e.g., \"8, 16\" or \"7\")",
              "VAR _ResultString = ",
              "    CONCATENATEX(",
              "        FILTER(_BE_PointsTable, NOT ISBLANK([BE_Month])),",
              "        [BE_Month],",
              "        \", \"",
              "    )",
              "",
              "-- Extract the single 3-Year breakeven month for 1-slope plans",
              "VAR _FirstSingleBEMonth = ",
              "    MINX(",
              "        FILTER(_BE_PointsTable, NOT ISBLANK([BE_Month])),",
              "        [BE_Month]",
              "    )",
              "",
              "-------------------------------------------------------------------------",
              "-- 3. FINAL SWITCH OUTPUT LOGIC",
              "-------------------------------------------------------------------------",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        -- On-Demand benchmark",
              "        _IsOnDemand, \"Base\",",
              "        ",
              "        -- No Upfront Plans (1Y & 3Y No UF): Zero CapEx, immediate payback",
              "        _IsNoUpfront, \"M1 (Instant)\",",
              "        ",
              "        -- 3-Year Commitment Plans (1-Slope): Single overall breakeven point",
              "        _LeaseYear = 3 && NOT ISBLANK(_FirstSingleBEMonth), \"Mo \" & _FirstSingleBEMonth & \" (One-time)\",",
              "        ",
              "        -- 1-Year Upfront Plans (Step-Up): Displays all real breakeven points dynamically",
              "        _LeaseYear = 1 && NOT ISBLANK(_ResultString), \"Mo \" & _ResultString,",
              "        ",
              "        -- Fallback if no crossover occurs",
              "        \"N/A\"",
              "    )"
            ],
            "lineageTag": "4872ce3d-9e15-415d-b58f-fe99a3e5dd71"
          },
          {
            "name": "FirstCycleBreakEvenMonth",
            "expression": [
              "",
              "    VAR _LeaseYear = SELECTEDVALUE(fct_ec2_pricing[lease_year], AVERAGE(fct_ec2_pricing[lease_year]))",
              "    VAR _MaxSearchMonth = IF(_LeaseYear = 1, 12, 36)",
              "    VAR _cal = ",
              "        MINX(",
              "            FILTER(",
              "                ALL(dim_month_axis[Value]),",
              "                dim_month_axis[Value] <= _MaxSearchMonth &&",
              "                [P5 M_Cumulative Spend] < ",
              "                    CALCULATE(",
              "                        [P5 M_Cumulative Spend],",
              "                        fct_ec2_pricing[pricing_plan_label] = \"On-Demand Base\",",
              "                        REMOVEFILTERS(fct_ec2_pricing[pricing_plan_label])",
              "                    )",
              "            ),",
              "            dim_month_axis[Value]",
              "        )",
              "RETURN _cal"
            ],
            "formatString": "0",
            "lineageTag": "3eab3728-2d03-4651-b3b0-b69066b90365"
          },
          {
            "name": "P5 M_Card_Top_1Y",
            "expression": [
              "",
              "",
              "-- Filter the pricing table down to 1-Year plans only",
              "VAR _1Y_Plans = ",
              "    FILTER(",
              "        ALLSELECTED(fct_ec2_pricing[pricing_plan_label]),",
              "        fct_ec2_pricing[pricing_plan_label] IN {\"1Y All UF\", \"1Y Partial UF\", \"1Y No UF\"}",
              "    )",
              "",
              "-- Dynamically find the single 1-Year plan label with the highest Net Savings",
              "VAR _Top1YPlan = ",
              "    TOPN(",
              "        1,",
              "        _1Y_Plans,",
              "        [P5 M_3Yr_Net_Savings],",
              "        DESC",
              "    )",
              "",
              "-- Extract metrics for that winning plan",
              "VAR _TopPlanLabel = MAXX(_Top1YPlan, fct_ec2_pricing[pricing_plan_label])",
              "VAR _Savings = CALCULATE([P5 M_3Yr_Net_Savings], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "VAR _Discount = CALCULATE([P5 M_Discount_Percent], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "VAR _BE = CALCULATE([P5 M_BreakEven_Display], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "",
              "RETURN",
              "    _TopPlanLabel & UNICHAR(10) & ",
              "    \"Saved: $\" & FORMAT(_Savings, \"#,##0\") & UNICHAR(10) &",
              "    \" Dis% \" & FORMAT(_Discount, \"0%\") & UNICHAR(10) &  ",
              "    \"BreakEven: \" & _BE"
            ],
            "lineageTag": "7ffbdc2f-3e75-40ad-b32e-86799ba150db"
          },
          {
            "name": "P5 M_Card_Top_3Y",
            "expression": [
              "",
              "",
              "-- Filter the pricing table down to 3-Year plans only",
              "VAR _3Y_Plans = ",
              "    FILTER(",
              "        ALLSELECTED(fct_ec2_pricing[pricing_plan_label]),",
              "        fct_ec2_pricing[pricing_plan_label] IN {\"3Y All UF\", \"3Y Partial UF\", \"3Y No UF\"}",
              "    )",
              "",
              "-- Dynamically find the single 1-Year plan label with the highest Net Savings",
              "VAR _Top1YPlan = ",
              "    TOPN(",
              "        1,",
              "        _3Y_Plans,",
              "        [P5 M_3Yr_Net_Savings],",
              "        DESC",
              "    )",
              "",
              "-- Extract metrics for that winning plan",
              "VAR _TopPlanLabel = MAXX(_Top1YPlan, fct_ec2_pricing[pricing_plan_label])",
              "VAR _Savings = CALCULATE([P5 M_3Yr_Net_Savings], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "VAR _Discount = CALCULATE([P5 M_Discount_Percent], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "VAR _BE = CALCULATE([P5 M_BreakEven_Display], fct_ec2_pricing[pricing_plan_label] = _TopPlanLabel)",
              "",
              "RETURN",
              "    _TopPlanLabel & UNICHAR(10) & ",
              "    \"Saved: $\" & FORMAT(_Savings, \"#,##0\") & UNICHAR(10) &",
              "    \" Dis% \" & FORMAT(_Discount, \"0%\") & UNICHAR(10) &  ",
              "    \"BreakEven: \" & _BE"
            ],
            "lineageTag": "ddc9051d-dae7-44c4-905f-5061fa236154"
          },
          {
            "name": "Windows Premium %",
            "expression": [
              "",
              "VAR _LinuxAvg =",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        fct_ec2_pricing[operating_system] = \"Linux\",",
              "        fct_ec2_pricing[pre_installed_sw] = \"na\",",
              "        fct_ec2_pricing[license_model] = \"no license required\",",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "VAR _WindowsAvg =",
              "    CALCULATE(",
              "        [HourlyRate_Avg],",
              "        fct_ec2_pricing[operating_system] = \"Windows\",",
              "        fct_ec2_pricing[pre_installed_sw] = \"na\",",
              "        fct_ec2_pricing[license_model] = \"no license required\",",
              "        fct_ec2_pricing[term_type] = \"OnDemand\"",
              "    )",
              "RETURN",
              "    IF(ISBLANK(_LinuxAvg) || _LinuxAvg = 0, BLANK(), DIVIDE(_WindowsAvg, _LinuxAvg) - 1)"
            ],
            "formatString": "+0%;-0%;0%",
            "lineageTag": "4886c70b-8563-4ea3-b08a-d1ba001df274"
          },
          {
            "name": "Total Instance Offers",
            "expression": [
              "COUNTROWS(",
              "    SUMMARIZE(",
              "        fct_ec2_pricing,",
              "        fct_ec2_pricing[instance_type],",
              "        fct_ec2_pricing[operating_system]",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f190e682-b660-42bd-a85d-302bc26aac98"
          },
          {
            "name": "P4 Instance Label",
            "expression": [
              "",
              "VAR _DistinctCount = DISTINCTCOUNT(fct_ec2_pricing[instance_type])",
              "RETURN",
              "    IF(",
              "        _DistinctCount = 1,",
              "        SELECTEDVALUE(fct_ec2_pricing[instance_type]),",
              "        SELECTEDVALUE(dim_instances[instance_family_category], \"Multiple\") & ",
              "            \" (\" & _DistinctCount & \" instance types)\"",
              "    )"
            ],
            "lineageTag": "0ee61798-5779-43ee-8bcb-f15986f591b4"
          }
        ],
